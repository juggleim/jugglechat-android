<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="69dp"
    android:background="@color/white"
    android:foreground="?android:attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:clipToOutline="true"
        android:contentDescription="avatar"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/right_meta_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mute"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/icon_mute"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:textColor="@color/conversation_secondary_text"
                android:textSize="12sp"
                tools:text="12:00" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_unread_count"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_unread_count_capsule"
            android:gravity="center"
            android:minWidth="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="99+"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/v_muted_unread_dot"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_unread_small_dot" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/conversation_primary_text"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/right_meta_container"
        app:layout_constraintStart_toEndOf="@id/iv_avatar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="群聊名称" />

    <LinearLayout
        android:id="@+id/last_msg_container"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/right_meta_container"
        app:layout_constraintStart_toStartOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/tv_name">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginEnd="2dp">

            <ProgressBar
                android:id="@+id/msg_progress"
                style="?android:attr/progressBarStyleSmallInverse"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:indeterminateDrawable="@drawable/msg_loading"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_msg_status"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_send_error"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_last_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/conversation_secondary_text"
            android:textSize="12sp"
            tools:text="最后一条消息内容" />
    </LinearLayout>

    <View
        android:id="@+id/item_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="12dp"
        android:background="@color/conversation_item_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_avatar" />

</androidx.constraintlayout.widget.ConstraintLayout>
