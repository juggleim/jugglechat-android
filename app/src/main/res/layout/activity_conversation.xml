<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/conversation_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/primary_bg_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_white" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/history_messages"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more_white" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_messages_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:background="@color/bg_light"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.juggle.im.android.chat.view.ChatInputActionBar
        android:id="@+id/input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:minHeight="58dp" />

    <FrameLayout
        android:id="@+id/overlayer_forward"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/overlay_forward_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone" />


        <FrameLayout
            android:id="@+id/selection_option_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/white"
            android:gravity="center"
            android:minHeight="58dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_gravity="top"
                android:layout_marginBottom="51dp"
                android:background="@color/divider" />

            <ImageView
                android:id="@+id/btn_forward_selected"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="60dp"
                android:alpha="0.4"
                android:contentDescription="forward"
                android:padding="6dp"
                android:src="@drawable/ic_forward" />

            <ImageView
                android:id="@+id/btn_delete_selected"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="60dp"
                android:alpha="0.4"
                android:contentDescription="delete"
                android:padding="6dp"
                android:src="@drawable/ic_delete_msg" />

        </FrameLayout>

    </FrameLayout>

    <include
        android:id="@+id/layout_pin_message"
        layout="@layout/layout_pin_message"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="30dp"
        android:layout_marginTop="50dp"
        android:layout_gravity="top"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
