<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_menu_background"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_conversation_menu_top"/>

        <TextView
            android:id="@+id/menu_top"
            android:layout_width="wrap_content"
            android:paddingStart="15dp"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:text="置顶"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="#E0E0E0" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_conversation_menu_mark_unread"/>

        <TextView
            android:id="@+id/menu_unread"
            android:layout_width="wrap_content"
            android:paddingStart="15dp"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:text="标为未读"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_mute"/>

        <TextView
            android:id="@+id/menu_mute"
            android:layout_width="wrap_content"
            android:paddingStart="15dp"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:text="免打扰"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_msg_action_delete"/>

        <TextView
            android:id="@+id/menu_delete"
            android:layout_width="wrap_content"
            android:paddingStart="15dp"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:text="删除"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>
