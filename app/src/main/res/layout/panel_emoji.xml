<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="250dp">

    <!-- Main vertical content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/input_bg_light"
        android:orientation="vertical">

        <!-- Use a single vertically scrollable grid for emojis instead of a horizontal ViewPager -->
        <GridView
            android:id="@+id/emoji_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="2dp"
            android:layout_weight="1"
            android:numColumns="8"
            android:verticalSpacing="4dp"
            android:horizontalSpacing="4dp"
            android:stretchMode="columnWidth"
            android:gravity="center" />

    </LinearLayout>

    <!-- Overlay floating actions: delete and send pinned to bottom-end -->
    <LinearLayout
        android:id="@+id/emoji_floating_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom|end"
        android:background="@drawable/rectangle_bg"
        android:layout_margin="12dp">

        <ImageView
            android:id="@+id/emoji_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="delete"
            android:padding="8dp"
            android:src="@drawable/ic_emoji_del" />

        <TextView
            android:id="@+id/emoji_send"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/send"
            android:textColor="@color/primary_bg_light" />

    </LinearLayout>

</FrameLayout>
