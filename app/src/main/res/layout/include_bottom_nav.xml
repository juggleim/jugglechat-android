<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tab_chats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">


            <TextView
                android:id="@+id/unread_dot"
                android:layout_width="21dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="15dp"
                android:gravity="center"
                android:text="99"
                android:visibility="gone"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:background="@drawable/red_circle_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_chats_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/tab_chat"
                    app:tint="@color/app_primary" />

                <TextView
                    android:id="@+id/tab_chats_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_chat"
                    android:textColor="@color/app_primary"
                    android:textSize="12sp" />
            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/tab_contacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_contacts_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/tab_contact"
                app:tint="@android:color/darker_gray" />

            <TextView
                android:id="@+id/tab_contacts_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_contact"
                android:textColor="@android:color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_discover_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/tab_friend"
                app:tint="@android:color/darker_gray" />

            <TextView
                android:id="@+id/tab_discover_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_friend"
                android:textColor="@android:color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_me"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_me_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/tab_me"
                app:tint="@android:color/darker_gray" />

            <TextView
                android:id="@+id/tab_me_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_me"
                android:textColor="@android:color/black"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
