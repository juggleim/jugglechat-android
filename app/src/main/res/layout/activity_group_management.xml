<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:orientation="vertical">

    <!-- 顶部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/group_management_title"
            android:textColor="@color/conversation_header_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_confirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/create_group_confirm"
            android:textColor="@color/app_primary"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- 权限设置卡片 -->
            <LinearLayout
                android:id="@+id/card_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_setting_add_member"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_mode="arrow"
                    app:srv_showDivider="true"
                    app:srv_title="@string/group_perm_add_member" />

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_setting_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_mode="arrow"
                    app:srv_showDivider="true"
                    app:srv_title="@string/group_perm_top_message" />

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_setting_mention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_mode="arrow"
                    app:srv_showDivider="true"
                    app:srv_title="@string/group_perm_mention_all" />

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_setting_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_mode="arrow"
                    app:srv_showDivider="true"
                    app:srv_title="@string/group_perm_edit_info" />

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_setting_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_mode="arrow"
                    app:srv_showDivider="true"
                    app:srv_title="@string/group_perm_send_message" />

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_setting_life"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_mode="arrow"
                    app:srv_showDivider="false"
                    app:srv_title="@string/group_perm_lifetime" />

            </LinearLayout>

            <!-- 开关设置卡片 -->
            <LinearLayout
                android:id="@+id/card_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_history_visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_mode="toggle"
                    app:srv_showDivider="false"
                    app:srv_title="@string/group_history_for_new_member" />

            </LinearLayout>

            <!-- 群主操作卡片 -->
            <LinearLayout
                android:id="@+id/card_owner_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical"
                android:visibility="gone">

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_group_admins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_icon="@drawable/ic_contact_entry_groups"
                    app:srv_mode="arrow"
                    app:srv_showDivider="true"
                    app:srv_title="@string/group_admins_title" />

                <com.juggle.im.android.chat.widget.SettingRowView
                    android:id="@+id/row_transfer_owner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srv_icon="@drawable/ic_forward"
                    app:srv_mode="arrow"
                    app:srv_showDivider="false"
                    app:srv_title="@string/group_transfer_owner" />

            </LinearLayout>

            <!-- 解散群组按钮 -->
            <TextView
                android:id="@+id/btn_dissolve_group"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_group_setting_danger_button"
                android:gravity="center"
                android:text="@string/group_dissolve"
                android:textColor="@color/red"
                android:textSize="15sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
