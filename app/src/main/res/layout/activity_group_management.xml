<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/group_bg_page"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="群组管理"
            android:textColor="@color/conversation_header_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tv_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:text="确定"
            android:textColor="@color/app_primary"
            android:textSize="14sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/card_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_setting_add_member"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_setting_pin"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_setting_mention"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_setting_edit"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_setting_chat"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_setting_life"
                    layout="@layout/item_group_setting_row" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_history_visible"
                    layout="@layout/item_group_setting_row" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_owner_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_group_admins"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_transfer_owner"
                    layout="@layout/item_group_setting_row" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_dissolve_group"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_group_setting_danger_button"
                android:gravity="center"
                android:text="解散群组"
                android:textColor="@color/red"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
