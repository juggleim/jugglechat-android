<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_record_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:visibility="gone"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 底部弧形背景 -->
    <View
        android:id="@+id/voice_arc"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_voice_arc_recording" />

    <!-- 语音条（横向矩形圆角，位于弧形上方） -->
    <FrameLayout
        android:id="@+id/voice_bar"
        android:layout_width="160dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_voice_bar_recording"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_mic_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic_white" />

    </FrameLayout>

    <!-- 提示文字 -->
    <TextView
        android:id="@+id/voice_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:text="松开发送，上滑取消" />

</FrameLayout>
