<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_gb">

    <SurfaceView
        android:id="@+id/remote_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/v_remote_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_call_status_scrim" />

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/tv_call_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="00:00"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_minimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_call_top_action"
            android:contentDescription="@string/call_action_minimize"
            android:padding="6dp"
            android:src="@drawable/icon_call_minimize" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/call_user_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="130dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/img_avatar"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/gray_circle_bg"
            android:src="@drawable/icon_default_avatar" />

        <TextView
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/main_default_user_name"
            android:textColor="@android:color/white"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/call_status_voice_outgoing"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <SurfaceView
        android:id="@+id/local_surface_view"
        android:layout_width="112dp"
        android:layout_height="166dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_call_video_self_window"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btn_switch_camera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/bottom_panel"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_call_top_action"
        android:contentDescription="@string/call_action_switch_camera"
        android:padding="10dp"
        android:src="@drawable/icon_switch_camera"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:id="@+id/secondary_action_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btn_mic"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_mic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/gray_circle_bg"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_mic_on" />

                <TextView
                    android:id="@+id/tv_mic_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_action_mic_on"
                    android:textColor="@color/call_action_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_speaker"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_speaker"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/gray_circle_bg"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_speaker_on" />

                <TextView
                    android:id="@+id/tv_speaker_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_action_speaker_on"
                    android:textColor="@color/call_action_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_camera"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_camera"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/gray_circle_bg"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_camera_white" />

                <TextView
                    android:id="@+id/tv_camera_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_action_camera_on"
                    android:textColor="@color/call_action_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/audio_connected_action_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btn_audio_mic"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_audio_mic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/gray_circle_bg"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_mic_on" />

                <TextView
                    android:id="@+id/tv_audio_mic_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_action_mic_on"
                    android:textColor="@color/call_action_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_audio_hangup"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_audio_hangup"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/red_circle_bg"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_hangup" />

                <TextView
                    android:id="@+id/tv_audio_hangup_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_action_cancel"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_audio_speaker"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_audio_speaker"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/gray_circle_bg"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_speaker_on" />

                <TextView
                    android:id="@+id/tv_audio_speaker_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_action_speaker_on"
                    android:textColor="@color/call_action_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/primary_action_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_hangup"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/red_circle_bg"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_hangup" />

                <TextView
                    android:id="@+id/tv_hangup_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_action_cancel"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_accept"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="64dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/green_circle_bg"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_accept" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/call_action_accept"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
