<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/group_bg_page"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text=""
            android:textColor="@color/conversation_header_text"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/iv_edit_group"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:contentDescription="edit"
            android:src="@drawable/ic_msg_action_edit"
            android:tint="@color/conversation_primary_text"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"
            android:background="@color/conversation_item_divider" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/header_group_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/iv_group_avatar"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_default_avatar" />

                <TextView
                    android:id="@+id/tv_group_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/conversation_primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_group_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/search_secondary_text"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layout_member_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <include
                    android:id="@+id/tool_top"
                    layout="@layout/item_group_tool" />

                <include
                    android:id="@+id/tool_translate"
                    layout="@layout/item_group_tool" />

                <include
                    android:id="@+id/tool_mute"
                    layout="@layout/item_group_tool" />

                <include
                    android:id="@+id/tool_clear"
                    layout="@layout/item_group_tool" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_announcement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_group_announcement"
                    layout="@layout/item_group_setting_row" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_group_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_add_member"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_group_members"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_group_display_name"
                    layout="@layout/item_group_setting_row" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_group_manage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_group_management"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_group_qrcode"
                    layout="@layout/item_group_setting_row" />

                <include
                    android:id="@+id/row_group_info"
                    layout="@layout/item_group_setting_row"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_common_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_group_setting_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_report"
                    layout="@layout/item_group_setting_row" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_quit_group"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_group_setting_danger_button"
                android:gravity="center"
                android:text="退出群组"
                android:textColor="@color/red"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
