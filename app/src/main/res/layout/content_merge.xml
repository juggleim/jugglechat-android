<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pin_message_card"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/merge_msg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="220dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/conversation_primary_text"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="聊天记录" />

    <TextView
        android:id="@+id/merge_preview_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:maxWidth="220dp"
        android:textColor="@color/conversation_secondary_text"
        android:textSize="12sp"
        tools:text="张三：你好\n李四：收到\n王五：稍后处理" />

    <View
        android:layout_width="220dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/conversation_item_divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/history_messages"
        android:textColor="@color/conversation_secondary_text"
        android:textSize="11sp" />
</LinearLayout>
