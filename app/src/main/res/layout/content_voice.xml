<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/layout_voice_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minWidth="116dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:id="@+id/button_play_voice"
            android:layout_width="72dp"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/msg_wave_bar_1"
                android:layout_width="3dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_voice_wave_bar" />

            <View
                android:id="@+id/msg_wave_bar_2"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_voice_wave_bar" />

            <View
                android:id="@+id/msg_wave_bar_3"
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_voice_wave_bar" />

            <View
                android:id="@+id/msg_wave_bar_4"
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_voice_wave_bar" />

            <View
                android:id="@+id/msg_wave_bar_5"
                android:layout_width="3dp"
                android:layout_height="20dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_voice_wave_bar" />

            <View
                android:id="@+id/msg_wave_bar_6"
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_voice_wave_bar" />

            <View
                android:id="@+id/msg_wave_bar_7"
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_voice_wave_bar" />

            <View
                android:id="@+id/msg_wave_bar_8"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_voice_wave_bar" />

            <View
                android:id="@+id/msg_wave_bar_9"
                android:layout_width="3dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_voice_wave_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_voice_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            tools:text="12.2"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
