<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- selection checkbox, hidden by default -->
    <com.juggle.im.android.widget.JuggleCheckBox
        android:id="@+id/checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:gravity="end"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 用 FrameLayout 让 reaction 和 bubble 叠放 -->
                <FrameLayout
                    android:id="@+id/message_stack_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- 底层：消息气泡 -->
                    <LinearLayout
                        android:id="@+id/message_bubble_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_message_sent"
                        android:gravity="end"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp">

                        <!-- container where a single content layout will be inflated at runtime -->
                        <LinearLayout
                            android:id="@+id/message_content_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="50dp"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:id="@+id/reaction_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/reaction_chip_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/msg_status_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:gravity="center_vertical|end"
                            android:orientation="horizontal"
                            android:paddingStart="2dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="2dp"
                            android:paddingBottom="1dp">

                            <TextView
                                android:id="@+id/msg_sent_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#CCFFFFFF"
                                android:textSize="11sp"
                                tools:text="10:01" />

                            <FrameLayout
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp">

                                <ImageView
                                    android:id="@+id/msg_read_status"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_msg_read"
                                    android:visibility="gone" />

                                <ProgressBar
                                    android:id="@+id/msg_send_status"
                                    style="?android:attr/progressBarStyleSmall"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:indeterminate="true"
                                    android:indeterminateTint="#CCFFFFFF"
                                    android:visibility="gone" />
                            </FrameLayout>

                        </LinearLayout>
                    </LinearLayout>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/reply_preview_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>

            <ImageView
                android:id="@+id/image_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_avatar_placeholder" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
