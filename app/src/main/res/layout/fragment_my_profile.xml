<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="150dp"
        android:background="@color/group_bg_page" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部用户信息区域：背景由 MainActivity 统一绘制，保证与标题栏、状态栏连续 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <!-- 用户信息区域 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="25dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 头像外边框 -->
                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_avatar_white_border">

                        <ImageView
                            android:id="@+id/iv_avatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_nickname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/group_text_title"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="用户名" />

                        <TextView
                            android:id="@+id/tv_user_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/group_text_secondary"
                            android:textSize="16sp"
                            tools:text="账号：@xxx" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_qrcode"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        android:src="@drawable/ic_qrcode" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/group_bg_page"
                android:orientation="vertical">

                <!-- 设置列表分组1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_group_setting_card"
                    android:elevation="0dp"
                    android:orientation="vertical">

                    <!-- 个人设置 -->
                    <include
                        android:id="@+id/row_personal_settings"
                        layout="@layout/item_group_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- 设置列表分组2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_group_setting_card"
                    android:elevation="0dp"
                    android:orientation="vertical">

                    <!-- 通用设置 -->
                    <include
                        android:id="@+id/row_general_settings"
                        layout="@layout/item_group_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/group_bg_divider" />

                    <!-- 我的收藏 -->
                    <include
                        android:id="@+id/row_favorites"
                        layout="@layout/item_group_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 设置列表分组3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_group_setting_card"
                    android:elevation="0dp"
                    android:orientation="vertical">

                    <!-- 用户协议 -->
                    <include
                        android:id="@+id/row_user_agreement"
                        layout="@layout/item_group_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/group_bg_divider" />

                    <!-- 隐私协议 -->
                    <include
                        android:id="@+id/row_privacy_policy"
                        layout="@layout/item_group_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/group_bg_divider" />

                    <!-- 意见反馈 -->
                    <include
                        android:id="@+id/row_feedback"
                        layout="@layout/item_group_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@color/group_bg_divider" />

                    <!-- 版本信息 -->
                    <include
                        android:id="@+id/row_version"
                        layout="@layout/item_group_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
