<resources>
    <style name="TextAppearance.Auth" parent="@style/TextAppearance.AppCompat" />

    <style name="TextAppearance.Auth.Tab" parent="@style/TextAppearance.Auth" />

    <style name="TextAppearance.Auth.Tab.Active" parent="@style/TextAppearance.Auth.Tab">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/auth_primary</item>
    </style>

    <style name="TextAppearance.Auth.Tab.Inactive" parent="@style/TextAppearance.Auth.Tab">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/auth_text_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Auth.Label" parent="@style/TextAppearance.Auth">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/auth_text_primary</item>
    </style>

    <style name="TextAppearance.Auth.Hint" parent="@style/TextAppearance.Auth">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/auth_text_secondary</item>
    </style>

    <style name="TextAppearance.Auth.Button" parent="@style/TextAppearance.Auth">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
