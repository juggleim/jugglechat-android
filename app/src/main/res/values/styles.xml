<resources>

    <style name="Theme.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_window</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/app_primary</item>
        <item name="android:navigationBarColor">@color/app_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:statusBarColor">@color/primary_bg_light</item>
        <item name="colorPrimary">@color/primary_bg_light</item>
        <item name="colorPrimaryDark">@color/primary_bg_dark</item>
        <item name="colorAccent">@color/bg_light</item>
    </style>
    <!-- 通话页面主题：深色 windowBackground 避免启动时白色闪烁 -->
    <style name="CallActivityTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/call_gb</item>
        <item name="android:statusBarColor">@color/call_gb</item>
    </style>

    <!--
      图片预览页主题。
      TIPS: 首帧的窗口配色由主题决定，代码里的 enableFullscreen() 要等 DecorView attach 后才生效，
      期间 DecorView 仍按 fitsSystemWindows 布局，会在顶部露出一条 windowBackground 高亮色（闪白）。
      因此必须在主题层就把 windowBackground / 系统栏全部压黑。
    -->
    <style name="ImagePreviewTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Widget" parent="android:Widget"/>

    <style name="NoTitleTextAppearance">
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:textSize">0sp</item>
    </style>
    <style name="TitleTextAppearance">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
    </style>

    <!-- BottomSheetDialog 透明背景样式 -->
    <style name="TransparentBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/TransparentBottomSheet</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>

    <style name="TransparentBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- 底部导航 AI 入口图标圆形 -->
    <style name="RoundedAiIcon">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- BottomActionSheet 底部弹窗样式 -->
    <style name="BottomActionSheetDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
